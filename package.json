{
  "name": "sotto",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "SOTTO_DEV=1 tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && mkdir -p dist/server/server/prompts && cp server/prompts/*.md dist/server/server/prompts/ && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "capture": "tsx scripts/capture-events.ts",
    "fixture:render": "tsx scripts/render-fixture.ts",
    "hello:measure": "tsx scripts/measure-hello.ts",
    "demo:slides": "node scripts/render-slides.mjs",
    "demo:narration": "tsx scripts/render-narration.ts",
    "demo:transcribe-sotto": "tsx scripts/demo-transcribe-sotto.ts",
    "demo:timeline": "node scripts/demo-timeline.mjs",
    "demo:video": "node scripts/build-demo-video.mjs",
    "demo:check": "node scripts/build-demo-video.mjs --check",
    "demo:x": "node scripts/build-demo-video.mjs --cut x",
    "e2e": "tsx scripts/e2e.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "eval:ceiling": "tsx scripts/eval-ceiling.ts",
    "shadow": "tsx scripts/shadow.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:voice": "node scripts/verify-voice.mjs",
    "verify:cards": "node scripts/verify-cards.mjs",
    "verify:mic": "node scripts/verify-mic.mjs",
    "verify:wake": "node scripts/verify-wake.mjs",
    "verify:controls": "node scripts/verify-controls.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "verify:answer": "node scripts/verify-answer.mjs",
    "verify:ask": "node scripts/verify-ask.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:transcript": "node scripts/verify-sotto-transcript.mjs",
    "verify:hello": "node scripts/verify-hello.mjs",
    "verify:judgment": "node scripts/verify-judgment.mjs",
    "verify:research": "node scripts/verify-research.mjs",
    "verify:speak": "node scripts/verify-speak.mjs",
    "verify:followups": "node scripts/verify-followups.mjs",
    "verify:briefing": "node scripts/verify-briefing.mjs",
    "verify:digest": "node scripts/verify-digest.mjs",
    "verify:hand": "node scripts/verify-hand.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "openai": "^7.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
