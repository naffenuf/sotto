{
  "name": "sotto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && mkdir -p dist/server/server/prompts && cp server/prompts/*.md dist/server/server/prompts/ && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "capture": "tsx scripts/capture-events.ts",
    "e2e": "tsx scripts/e2e.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:cards": "node scripts/verify-cards.mjs",
    "verify:mic": "node scripts/verify-mic.mjs",
    "verify:wake": "node scripts/verify-wake.mjs",
    "verify:chattiness": "node scripts/verify-chattiness.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "verify:answer": "node scripts/verify-answer.mjs",
    "verify:ask": "node scripts/verify-ask.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "openai": "^7.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
