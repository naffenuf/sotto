.env
node_modules/
dist/
sessions/
ralph/loop.log
ralph/STOP
.DS_Store
ralph/iterations/
*.tmp.mjs

# Eval harness output: session folders, raw runs and cached judge verdicts.
eval/sessions/
eval/runs/
eval/cache/

# End-to-end check output: one session folder per fixture, per run.
e2e/sessions/

# Shadow runs (V3-016): one session folder and one run record per replay. The
# report in tasks/ is what is committed; `--report` rebuilds it from the record.
shadow/sessions/
shadow/runs/

# The group's own files (V3-009). Real customer lists and notes never get
# committed; `fixtures/knowledge-demo/` is the fictional one that does.
# Anchored at the root on purpose: a bare `knowledge/` would also hide
# `server/knowledge/`.
/knowledge/

# The group's MCP servers (post-V3-011). A real config names real systems and
# may carry a command line nobody else should see; `docs/mcp.md` has examples.
/mcp.json

# Demo soundtrack mixes, rebuilt by scripts/pan-fixture.mjs
fixtures/audio/*.stereo.wav

# Screen recordings of demo takes (large; the keeper is copied here)
demo/takes/
