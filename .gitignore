.env
node_modules/
dist/
sessions/
ralph/loop.log
ralph/STOP
.DS_Store
ralph/iterations/
*.tmp.mjs

# Eval harness output: session folders, raw runs and cached judge verdicts.
eval/sessions/
eval/runs/
eval/cache/

# End-to-end check output: one session folder per fixture, per run.
e2e/sessions/

# Shadow runs (V3-016): one session folder and one run record per replay. The
# report in tasks/ is what is committed; `--report` rebuilds it from the record.
shadow/sessions/
shadow/runs/

# The group's own files (V3-009). Real customer lists and notes never get
# committed; `fixtures/knowledge-demo/` is the fictional one that does.
# Anchored at the root on purpose: a bare `knowledge/` would also hide
# `server/knowledge/`.
/knowledge/
