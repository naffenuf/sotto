# Meta Model API key. Server-only — this value must never reach the browser bundle.
MODEL_API_KEY=

# Optional: port the local Sotto server binds on 127.0.0.1 (default 8787).
# PORT=8787

# ElevenLabs API key, for Sotto's voice and for rendering fixture audio.
# Server-only — this value must never reach the browser bundle.
ELEVENLABS_API_KEY=

# Optional: the ElevenLabs voice Sotto speaks with. Defaults to the "River"
# library voice (SAz9YHcvj6GT2YYXdXww) — calm, and clearly apart from the two
# fixture voices in fixtures/voices.json.
# ELEVENLABS_VOICE_ID=

# Muse Glimmer, served locally behind an OpenAI-compatible endpoint, for the
# short judgment calls (V2-010). Optional: with neither set, those calls go to
# Muse Spark in the cloud instead and the header's judgment dot says so.
# GLIMMER_BASE_URL=http://127.0.0.1:11434/v1
# GLIMMER_MODEL=muse-glimmer:30b-q4_K_M
