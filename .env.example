# Meta Model API key. Server-only — this value must never reach the browser bundle.
MODEL_API_KEY=

# Optional: port the local Sotto server binds on 127.0.0.1 (default 8787).
# PORT=8787

# ElevenLabs API key, for Sotto's voice and for rendering fixture audio.
# Server-only — this value must never reach the browser bundle.
ELEVENLABS_API_KEY=

# Optional: the ElevenLabs voice Sotto speaks with (default: a calm library voice).
# ELEVENLABS_VOICE_ID=
