{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "*.ts"
  ]
}
